# Public URL shown in logs / MCP metadata
PUBLIC_BASE_URL=https://search.example.com

# Comma-separated bearer tokens for HTTP/MCP clients
API_KEYS=change-me-key-1,change-me-key-2

# Infra
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=900
RATE_LIMIT_PER_MINUTE=60
# After 401/402/403/429 (or quota-like errors), skip provider for N seconds
PROVIDER_COOLDOWN_SECONDS=900

# External Docker network shared with your reverse proxy (Caddy/Traefik/etc.)
CADDY_DOCKER_NETWORK=caddy_proxy

# Intent via OpenRouter Jev (Decisions API). OPENROUTER_API_KEY is enough.
OPENROUTER_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api
LLM_API_KEY=
LLM_MODEL=typesafe/jev-1.14
INTENT_CONFIDENCE_THRESHOLD=0.55

# Search providers (register only if set)
SEARXNG_URL=
BRAVE_API_KEY=
SERPER_API_KEY=
# Legacy alias also accepted at runtime: SERPER_DEV_API_KEY
SERPAPI_API_KEY=
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev
SCRAPINGDOG_API_KEY=
CRAWL4AI_URL=
